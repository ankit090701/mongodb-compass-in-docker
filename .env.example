# ---- Versions --------------------------------------------------------------
# MongoDB Compass stable release (https://github.com/mongodb-js/compass/releases)
COMPASS_VERSION=1.53.2
# MongoDB server major release line (long-term supported). 9.0 is the newer major.
MONGO_VERSION=8.0

# ---- Browser access ----------------------------------------------------------
# Compass UI is served at http://localhost:${COMPASS_PORT}
COMPASS_PORT=8080
# Password asked by the browser page. VNC only uses the first 8 characters.
VNC_PASSWORD=compass1
# Initial screen size; the browser tab resizes it automatically.
VNC_RESOLUTION=1600x900

# ---- MongoDB root user (POC only - change for anything real) -----------------
# URL-encode special characters if you change the password; it is embedded in a connection string.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
